  "components": {
    "securitySchemes": {
      "PreviewAccess": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separate private64-lowercase-hex technical key; required in Vercel and whenever app foundation is enabled locally. Never browser-visible."
      },
      "AppAccessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Access-Token",
        "description": "Server-forwarded Supabase user JWT, independently verified against fixed issuer/JWKS/current session and membership. Never substitute the technical bearer."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Generic Vercel denial before database work.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Unauthorized"
            }
          }
        }
      },
      "AppBadRequest": {
        "description": "Strict input validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AppError"
            }
          }
        }
      },
      "AppUnauthorized": {
        "description": "Invalid technical key or user authentication/session.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Unauthorized"
                },
                {
                  "$ref": "#/components/schemas/AppError"
                }
              ]
            }
          }
        }
      },
      "AppForbidden": {
        "description": "Current membership/capability denied.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AppError"
            }
          }
        }
      },
      "AppNotFound": {
        "description": "Unknown or inaccessible scoped object.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AppError"
            }
          }
        }
      },
      "AppConflict": {
        "description": "Revision, invitation, ownership or idempotency conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AppError"
            }
          }
        }
      },
      "AppUnavailable": {
        "description": "Dependency unavailable or outcome uncertain; do not blindly retry delivery.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AppError"
            }
          }
        }
      }
    },
    "schemas": {
      "Unauthorized": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "unauthorized"
          }
        }
      },
      "Liveness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "Ready": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database",
          "migrations"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          },
          "database": {
            "type": "string",
            "const": "up"
          },
          "migrations": {
            "type": "string",
            "const": "current"
          }
        }
      },
      "Degraded": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "degraded"
          },
          "reason": {
            "type": "string",
            "enum": [
              "database_unavailable",
              "database_timeout",
              "migrations_pending"
            ]
          }
        }
      },
      "AppError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthenticated",
              "forbidden",
              "not_found",
              "revision_conflict",
              "last_owner",
              "invitation_conflict",
              "delivery_unavailable",
              "dependency_unavailable",
              "bootstrap_conflict"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AppProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "displayName",
          "revision"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Trimmed nonblank Unicode name; reject control characters and malformed Unicode."
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483646
          }
        }
      },
      "AppWorkspace": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Trimmed nonblank Unicode name; reject control characters and malformed Unicode."
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483646
          }
        }
      },
      "AppMember": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "displayName",
          "role",
          "status",
          "revision"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Trimmed nonblank Unicode name; reject control characters and malformed Unicode."
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483646
          }
        }
      },
      "AppMe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "email",
          "workspace",
          "membership",
