{
  "openapi": "3.1.0",
  "info": {
    "title": "Connectivity foundation",
    "version": "0.3.0",
    "description": "Local health remains unauthenticated. Vercel requires the private bearer key on every non-preflight request, including custom domains. Never expose that shared key in browser code."
  },
  "security": [{}, { "PreviewAccess": [] }],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "200": {
            "description": "Liveness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Degraded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Degraded"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PreviewAccess": {
        "type": "http",
        "scheme": "bearer",
        "description": "Vercel only: a separate private 64-character lowercase hex key."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Generic Vercel denial before database work.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Unauthorized" }
          }
        }
      }
    },
    "schemas": {
      "Unauthorized": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": { "status": { "type": "string", "const": "unauthorized" } }
      },
      "Liveness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "Ready": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database",
          "migrations"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          },
          "database": {
            "type": "string",
            "const": "up"
          },
          "migrations": {
            "type": "string",
            "const": "current"
          }
        }
      },
      "Degraded": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "degraded"
          },
          "reason": {
            "type": "string",
            "enum": [
              "database_unavailable",
              "database_timeout",
              "migrations_pending"
            ]
          }
        }
      }
    }
  }
}
