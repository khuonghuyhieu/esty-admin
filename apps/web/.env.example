# Build-time public facts, not secrets. No values are needed for a local draft.
# Copy to .env.local only when needed. Never commit real local configuration.
SITE_MODE=draft
# Modes: draft, preview, release. NODE_ENV=production does not imply release.
SITE_URL=
APP_NAME=
OPERATOR_NAME=
SUPPORT_EMAIL=
# Set to true only after the owner confirms the above facts and privacy wording.
PUBLICATION_CONFIRMED=false
# VERCEL_ENV is host-managed; preview cannot be built in release mode.

# Local diagnostic route only. Never enable on a hosted deployment.
LOCAL_CONNECTIVITY_ENABLED=false
# Canonical loopback HTTP origin; no credentials, path, query or fragment.
LOCAL_CONNECTIVITY_API_ORIGIN=http://127.0.0.1:3001

# Server-only app session configuration. Never use NEXT_PUBLIC aliases.
# Missing configuration keeps protected routes unavailable, not in preview-auth mode.
APP_SESSION_MODE=hosted
APP_ORIGIN=
APP_API_ORIGIN=
APP_API_TECHNICAL_KEY=
# Fixed Auth base, optionally ending in /auth/v1.
APP_AUTH_URL=
APP_AUTH_API_KEY=
# Exactly 32 random bytes encoded as unpadded base64url; supplied securely.
APP_SESSION_COOKIE_KEY=
# Local verification flags require the approved isolated staging/lifecycle.
APP_SESSION_E2E=0
APP_SESSION_E2E_RUN_ID=

# Native Git delivery uses vercel.json; Actions never deploys this frontend.
# Leave Vercel system-variable exposure enabled; do not set VERCEL_* manually here.
# Production provenance uses platform Git/project/target/deployment metadata.
# Only public revision/deployment IDs appear on home, privacy and login responses.
# FE checks run inside the native build, not before Vercel creates its deployment.
# Separate BE checks need owner-configured Vercel Deployment Checks to block promotion.
# Post-deploy public smoke is not authenticated Owner/session acceptance.
# Public smoke briefly waits for alias identity propagation (six attempts per path,
# 500ms apart within one 20s deadline); this is not a deployment/promotion gate.
