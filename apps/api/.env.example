# Synthetic credentials for the isolated local Compose fixture only.
API_RUNTIME=local
DATABASE_URL=postgresql://foundation_local:local_fixture_only@127.0.0.1:55432/foundation_local
API_HOST=127.0.0.1
API_PORT=3001
BROWSER_ORIGIN=http://127.0.0.1:3000

# Hosted API: do not copy the local binding or synthetic URL above to Vercel.
# Set API_RUNTIME=vercel there; VERCEL and PORT are platform-managed.
# Replace each bracketed value privately with approved Connect Session metadata.
# DATABASE_URL=postgresql://<role>.<project-ref>:<percent-encoded-password>@<exact-session-host>:5432/<database>
# SUPABASE_PROJECT_REF=<20-letter-project-ref>
# SUPABASE_SESSION_HOST=<exact-aws-session-host-from-Connect>
# SUPABASE_DATABASE_NAME=<database-from-Connect>
# SUPABASE_DATABASE_USER=<role>.<project-ref>
# BROWSER_ORIGIN=https://<approved-browser-host>
# Optional only when the verified chain needs a custom root: actual CA PEM,
# not a path or literal backslash-n string. System trusted roots are used if omitted.
# DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----
# <verified-CA-certificate-body>
# -----END CERTIFICATE-----"
#
# Separately authorized operator environment; never set these in the API function.
# MIGRATION_TARGET=supabase
# MIGRATION_DATABASE_URL=postgresql://<approved-role>.<project-ref>:<percent-encoded-password>@<exact-session-host>:5432/<database>
# MIGRATION_CONFIRM_PROJECT_REF=<same-approved-project-ref>
# Uses the same SUPABASE_* target tuple and optional DATABASE_CA_PEM.
# Neither a Supabase management token nor Vercel project/token IDs are API runtime inputs.

# Supabase-local development alternative (synthetic, after supabase:start):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Use explicit process configuration; do not overwrite an existing .env.
# Gateway/Studio are disabled in the minimum DB-only local stack.
#
# Selected Vercel Production runtime (not a local profile or deployment proof):
# API_RUNTIME=vercel
# VERCEL=1 and PORT are platform-managed; never copy them into local profiles.
# SUPABASE_PROJECT_REF=eotmpaliqcxxcotrcols
# SUPABASE_SESSION_HOST=aws-0-ap-northeast-2.pooler.supabase.com
# SUPABASE_DATABASE_NAME=postgres
# SUPABASE_DATABASE_USER=postgres.eotmpaliqcxxcotrcols
# DATABASE_URL=postgresql://postgres.eotmpaliqcxxcotrcols:<encoded-owner-password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# PREVIEW_ACCESS_KEY=<separate-owner-generated-64-lowercase-hex-key>
# BROWSER_ORIGIN=https://app.lovora.us
# PREVIEW_ACCESS_KEY protects every non-preflight request, including health endpoints.
# Never include API_HOST/API_PORT, MIGRATION_*, operator credentials or Vercel tokens.
